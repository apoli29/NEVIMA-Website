# Variables the site reads. Real values go in .env.local (never committed)
# and in Vercel > Project > Settings > Environment Variables.
# What each one does: docs/backend-decisions.md.

# Notion (where the requests go)
NOTION_TOKEN=
NOTION_FORM1_LEADS=
NOTION_FORM2_LEADS=

# Email
RESEND_API_KEY=

# SQL Server: a copy of every proposal request (src/lib/proposal/sql.ts)
MSSQL_SERVER=nevima-rg-de.database.windows.net
MSSQL_DATABASE=Nevima
MSSQL_USER=nevima_site
MSSQL_PASSWORD=
